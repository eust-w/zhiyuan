+def load_streamvln_config(path) -> LlavaQwenConfig:
+    """Read a local native or legacy flat-Qwen StreamVLN configuration.
+
+    The published legacy checkpoint is labelled ``llava`` but stores the real
+    Qwen parameters at the top level. Its nested default Llama/CLIP configs are
+    not the trained architecture and must never override those flat values.
+    This function does not fetch remote metadata, execute auto_map code, or
+    infer/resize vocabulary dimensions from tokenizer metadata.
+    """
+    config_path = Path(path).expanduser()
+    if config_path.is_dir():
+        config_path = config_path / "config.json"
+    try:
+        with config_path.open(encoding="utf-8") as stream:
+            values = json.load(stream)
+    except (OSError, json.JSONDecodeError) as error:
+        raise ValueError("a readable local StreamVLN config.json is required") from error
+    if not isinstance(values, dict):
+        raise ValueError("StreamVLN configuration must be a JSON object")
+    model_type = values.get("model_type")
+    if not isinstance(model_type, str) or model_type not in ("llava_qwen", "llava"):
+        raise ValueError("unsupported StreamVLN configuration model_type")
+    architectures = values.get("architectures")
+    supported = ("StreamVLNForCausalLM", "LlavaQwenForCausalLM")
+    if (architectures is not None and
+            (not isinstance(architectures, list) or not architectures or
+             any(not isinstance(name, str) or name not in supported for name in architectures))):
+        raise ValueError("unsupported StreamVLN configuration architecture")
+    if model_type == "llava" and architectures is None:
+        raise ValueError("legacy llava configuration must identify its Qwen architecture")
+    dimensions = ("vocab_size", "hidden_size", "intermediate_size", "num_hidden_layers",
+                  "num_attention_heads", "num_key_value_heads", "max_position_embeddings")
+    for name in dimensions:
+        if type(values.get(name)) is not int or values[name] <= 0:
+            raise ValueError(f"missing or invalid top-level Qwen dimension: {name}")
+    if (values["hidden_size"] % values["num_attention_heads"] or
+            values["num_attention_heads"] % values["num_key_value_heads"]):
+        raise ValueError("incompatible top-level Qwen attention dimensions")
+    for name in ("model_type", "text_config", "vision_config"):
+        values.pop(name, None)
+    return LlavaQwenConfig.from_dict(values)
+
+
+def restore_streamvln_vision_weights(model, base_path) -> dict:
+    """Restore embedded base vision parameters after language-only PEFT setup.
+
+    Delayed SigLIP construction prevents PEFT's language projection names from
+    matching vision layers, but it also makes from_pretrained skip the embedded
+    vision tensors. Restore them explicitly; external SigLIP is architecture
+    initialization only, never a successful fallback for missing base weights.
+    All shard paths/headers and the complete vision state are checked before
+    copying parameters. Only vision tensors, not language tensors, are read.
+    """
+    from safetensors import safe_open
+
+    root = Path(base_path).expanduser().resolve()
+    if not root.is_dir():
+        raise ValueError("a local base model directory is required")
+
+    def local_file(name, *, safetensors=False):
+        if (not isinstance(name, str) or not name or "\\" in name or
+                Path(name).is_absolute() or ".." in Path(name).parts or
+                (safetensors and not name.endswith(".safetensors"))):
+            raise ValueError("invalid local safetensors file reference")
+        candidate = (root / name).resolve()
+        if (not candidate.is_relative_to(root) or not candidate.is_file() or
+                candidate.stat().st_size == 0):
+            raise ValueError("safetensors file is missing, empty, or outside the base directory")
+        return candidate
+
+    single = root / "model.safetensors"
+    index = root / "model.safetensors.index.json"
+    single_present = single.exists() or single.is_symlink()
+    index_present = index.exists() or index.is_symlink()
+    if single_present == index_present:
+        raise ValueError("exactly one single-file or indexed base safetensors layout is required")
+    mapping = None
+    if single_present:
+        shards = {local_file(single.name, safetensors=True)}
+    else:
+        with local_file(index.name).open(encoding="utf-8") as stream:
+            metadata = json.load(stream)
+        mapping = metadata.get("weight_map") if isinstance(metadata, dict) else None
+        if not isinstance(mapping, dict) or not mapping:
+            raise ValueError("safetensors index requires a non-empty weight_map")
+        if any(not isinstance(key, str) or not key for key in mapping):
+            raise ValueError("safetensors index tensor names must be non-empty strings")
+        mapping = {key: local_file(name, safetensors=True) for key, name in mapping.items()}
+        shards = set(mapping.values())
+
+    prefix = "model.vision_tower."
+    sources = {}
+    for shard in sorted(shards):
+        with safe_open(str(shard), framework="pt", device="cpu") as reader:
+            for key in reader.keys():
+                if not key.startswith(prefix):
+                    continue
+                if key in sources:
+                    raise ValueError("duplicate embedded vision tensor across safetensors shards")
+                if mapping is not None and mapping.get(key) != shard:
+                    raise ValueError("embedded vision tensor disagrees with safetensors index")
+                sources[key] = shard
+    if not sources:
+        raise ValueError("base checkpoint is missing embedded vision weights; no external fallback is permitted")
+    if mapping is not None and set(sources) != {key for key in mapping if key.startswith(prefix)}:
+        raise ValueError("safetensors index references missing embedded vision tensors")
+
+    tower = model.get_vision_tower()
+    if tower is None:
+        raise ValueError("the scoped model requires a SigLIP vision tower")
+    if not tower.is_loaded:
+        tower.load_model()
+    expected = tower.state_dict()
+    if any("lora_" in key for key in expected):
+        raise ValueError("vision LoRA is outside the language-only adapter profile")
+    if set(sources) != {prefix + key for key in expected}:
+        raise ValueError("base checkpoint must contain the complete, exact embedded vision state")
+
+    restored = {}
+    for shard in sorted(set(sources.values())):
+        with safe_open(str(shard), framework="pt", device="cpu") as reader:
+            for key, source in sources.items():
+                if source != shard:
+                    continue
+                name = key[len(prefix):]
+                if tuple(reader.get_slice(key).get_shape()) != tuple(expected[name].shape):
+                    raise ValueError(f"embedded vision tensor shape mismatch: {name}")
+                restored[name] = reader.get_tensor(key)
+    tower.load_state_dict(restored, strict=True)
+    return {"status": "restored", "tensor_count": len(restored), "prefix": prefix,
+            "shards": [str(shard.relative_to(root)) for shard in sorted(set(sources.values()))]}
+
